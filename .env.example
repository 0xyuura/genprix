# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Admin passcode for the 🔒 panel in local/demo mode.
# Defaults to 000000 if unset. NOTE: Vite inlines VITE_* into the client bundle, so this
# is obscurity only — anyone can read it from the deployed JS. Real protection is secure
# mode below, where the passcode lives as a bcrypt hash in Postgres.
VITE_ADMIN_PASSCODE=000000

# Secure mode (global leaderboard + server-authoritative scoring). Leave both unset to
# stay in local/demo mode. See SETUP.md.
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
